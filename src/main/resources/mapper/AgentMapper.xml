<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.aiagent.mapper.AgentMapper">

    <resultMap id="BaseResultMap" type="com.example.aiagent.model.entity.Agent">
        <id property="id" column="id" jdbcType="VARCHAR"/>
        <result property="name" column="name" jdbcType="VARCHAR"/>
        <result property="description" column="description" jdbcType="VARCHAR"/>
        <result property="systemPrompt" column="system_prompt" jdbcType="VARCHAR"/>
        <result property="model" column="model" jdbcType="VARCHAR"/>
        <result property="allowedTools" column="allowed_tools" jdbcType="OTHER"
                typeHandler="com.example.aiagent.typehandler.JsonbTypeHandler"/>
        <result property="allowedKbs" column="allowed_kbs" jdbcType="OTHER"
                typeHandler="com.example.aiagent.typehandler.JsonbTypeHandler"/>
        <result property="chatOptions" column="chat_options" jdbcType="OTHER"
                typeHandler="com.example.aiagent.typehandler.JsonbTypeHandler"/>
        <result property="createdAt" column="created_at" jdbcType="TIMESTAMP"/>
        <result property="updatedAt" column="updated_at" jdbcType="TIMESTAMP"/>
    </resultMap>

    <select id="selectByIdBatch" resultMap="BaseResultMap">
        SELECT
        id, name, description, system_prompt, model,
        allowed_tools, allowed_kbs, chat_options,
        created_at, updated_at
        FROM agent
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            CAST(#{id} AS uuid)
        </foreach>
    </select>

</mapper>
