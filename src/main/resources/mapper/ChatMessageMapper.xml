<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.aiagent.mapper.ChatMessageMapper">

    <resultMap id="BaseResultMap" type="com.example.aiagent.model.entity.ChatMessage">
        <id property="id" column="id" jdbcType="VARCHAR"/>
        <result property="sessionId" column="session_id" jdbcType="VARCHAR"/>
        <result property="role" column="role" jdbcType="VARCHAR"/>
        <result property="content" column="content" jdbcType="VARCHAR"/>
        <result property="metadata" column="metadata" jdbcType="OTHER"
                typeHandler="com.example.aiagent.typehandler.JsonbTypeHandler"/>
        <result property="createdAt" column="created_at" jdbcType="TIMESTAMP"/>
        <result property="updatedAt" column="updated_at" jdbcType="TIMESTAMP"/>
    </resultMap>

    <select id="selectBySessionIdRecently" resultMap="BaseResultMap">
        SELECT id, session_id, role, content, metadata, created_at, updated_at
        FROM (
            SELECT id, session_id, role, content, metadata, created_at, updated_at
            FROM chat_message
            WHERE session_id = CAST(#{sessionId} AS uuid)
            ORDER BY created_at DESC
            LIMIT #{limit}
        ) sub
        ORDER BY created_at ASC
    </select>

</mapper>
