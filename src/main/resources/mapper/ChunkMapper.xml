<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.aiagent.mapper.ChunkMapper">

    <resultMap id="BaseResultMap" type="com.example.aiagent.model.entity.Chunk">
        <id property="id" column="id" jdbcType="VARCHAR"/>
        <result property="kbId" column="kb_id" jdbcType="VARCHAR"/>
        <result property="docId" column="doc_id" jdbcType="VARCHAR"/>
        <result property="content" column="content" jdbcType="VARCHAR"/>
        <result property="metadata" column="metadata" jdbcType="OTHER"
                typeHandler="com.example.aiagent.typehandler.JsonbTypeHandler"/>
        <result property="embedding" column="embedding" jdbcType="OTHER"
                typeHandler="com.example.aiagent.typehandler.PgVectorTypeHandler"/>
        <result property="createdAt" column="created_at" jdbcType="TIMESTAMP"/>
        <result property="updatedAt" column="updated_at" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, kb_id, doc_id, content, metadata, embedding, created_at, updated_at
    </sql>

    <select id="similaritySearch" resultMap="BaseResultMap">
        <![CDATA[
        SELECT
        <include refid="Base_Column_List"/>
        FROM chunk_bge_m3
        WHERE kb_id = CAST(#{kbId} AS uuid)
        ORDER BY embedding <-> #{vectorLiteral}::vector
        LIMIT #{limit}
        ]]>
    </select>

</mapper>
